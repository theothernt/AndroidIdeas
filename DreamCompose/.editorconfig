root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# The Kotlin sources and the build scripts are both tab-indented. ktlint defaults to spaces, so
# without this it reports every indented line in the project as a violation.
[*.kt]
indent_style = tab
indent_size = 4
ktlint_code_style = ktlint_official
max_line_length = 140

[*.kts]
indent_style = tab
indent_size = 4
ktlint_code_style = ktlint_official
max_line_length = 140

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2
