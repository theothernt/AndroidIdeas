# R8 rules for NavState.
#
# The Kotlin serialization Gradle plugin contributes its own rules for @Serializable types, and
# Compose, Lifecycle and Navigation 3 all ship consumer rules, so this file only has to cover what
# this app adds on top of those. Keep it narrow: blanket -keep rules for whole libraries will
# silently disable most of what isMinifyEnabled is meant to do.

# NavKeys are restored by class name, so their names and members must survive.
-keep class com.neilturner.navstate.navigation.NavKey { *; }
-keep class com.neilturner.navstate.navigation.Screen* { *; }

# Serializers are resolved reflectively.
-keepclassmembers class ** {
    @kotlinx.serialization.Serializable *;
}
-keepclassmembers class ** implements kotlinx.serialization.KSerializer {
    *;
}
-keep,includedescriptorclasses class com.neilturner.navstate.**$$serializer { *; }

# Read by the serializable plugin, Navigation 3 and Compose.
-keepattributes *Annotation*, InnerClasses, EnclosingMethod, Signature
