<?xml version="1.0" encoding="utf-8"?>
<!--
  A single left-to-right gradient across the full 108dp canvas.

  This is the whole icon. Because it is full-bleed with nothing centred on it, the adaptive
  icon needs no foreground layer at all - the background alone fills whatever shape the launcher
  masks to, and there is no artwork that a circular or squircle mask could clip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="54"
                android:endX="108"
                android:endY="54"
                android:type="linear">
                <item android:offset="0" android:color="#FF16324F" />
                <item android:offset="0.55" android:color="#FF0B1A2B" />
                <item android:offset="1" android:color="#FF05090F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
