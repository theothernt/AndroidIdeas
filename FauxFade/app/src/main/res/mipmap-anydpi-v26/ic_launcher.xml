<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, background only.

  The artwork is a full-bleed gradient with no foreground layer, so the launcher masks the
  background directly. minSdk is 26, so every device this installs on takes this path; the
  mipmap-*/ic_launcher.png bitmaps are only the fallback for anything older.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
</adaptive-icon>
